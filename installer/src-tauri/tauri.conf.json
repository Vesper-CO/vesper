{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vesper Setup",
  "version": "0.1.1",
  "identifier": "app.vesper.setup",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main", "title": "Vesper Setup", "width": 640, "height": 440,
        "resizable": false, "maximizable": false, "decorations": false, "center": true,
        "backgroundColor": "#0b0b17"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
